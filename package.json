{
  "name": "ws-pack",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ws:server": "bun server/echo-server.ts",
    "stomp:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "stomp:down": "docker compose -f docker-compose.test.yml down -v",
    "test": "bun test",
    "mqtt:server": "bun server/mqtt-server.ts"
  },
  "dependencies": {
    "@stomp/stompjs": "7.3.0",
    "mqtt": "^5.15.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "aedes": "^1.1.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "ws": "^8.21.3"
  }
}
