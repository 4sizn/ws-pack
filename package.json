{
  "name": "ws-pack",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "bun run build:lib",
    "build:demo": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.build.json && vite build -c vite.lib.config.ts",
    "dev": "vite",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "mqtt:server": "bun server/mqtt-server.ts",
    "preview": "vite preview",
    "stomp:down": "docker compose -f docker-compose.test.yml down -v",
    "stomp:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test": "bun test",
    "ws:server": "bun server/echo-server.ts"
  },
  "dependencies": {
    "@stomp/stompjs": "7.3.0",
    "mqtt": "^5.15.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "aedes": "^1.1.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "ws": "^8.21.3"
  },
  "description": "WebSocket 클라이언트 패키지 — STOMP / 순수 WebSocket / MQTT 를 같은 표면으로, Worker·SharedWorker 위에서도.",
  "sideEffects": [
    "./dist/lib/worker.js"
  ],
  "files": [
    "dist/lib",
    "dist/types",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./worker": {
      "types": "./dist/types/worker/socket-worker.d.ts",
      "import": "./dist/lib/worker.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "module": "./dist/lib/index.js"
}
